VISIONLAB_ENVIRONMENT=development
VISIONLAB_LOG_LEVEL=INFO
VISIONLAB_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
VISIONLAB_DATABASE_URL=sqlite:///./visionlab.db
VISIONLAB_INFERENCE_DEVICE=cpu
VISIONLAB_MEDIA_ROOT=data/media
VISIONLAB_THUMBNAIL_ROOT=data/thumbnails
VISIONLAB_MAX_IMAGE_BYTES=20971520
VISIONLAB_MAX_VIDEO_BYTES=262144000
VISIONLAB_MAX_VIDEO_DURATION_MS=600000
VISIONLAB_MAX_IMAGE_PIXELS=40000000
VISIONLAB_FFPROBE_BINARY=ffprobe
VISIONLAB_FFMPEG_BINARY=ffmpeg
VISIONLAB_PROBE_TIMEOUT_SECONDS=15
# Add server-side provider credentials in a later phase; never use a VITE_ prefix.
# OPENAI_API_KEY=

