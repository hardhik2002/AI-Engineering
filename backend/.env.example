VISIONLAB_ENVIRONMENT=development
VISIONLAB_LOG_LEVEL=INFO
VISIONLAB_LOG_CONSOLE_ENABLED=true
VISIONLAB_LOG_FILE_ENABLED=true
VISIONLAB_LOG_FORMAT=pretty
VISIONLAB_LOG_DIRECTORY=data/logs
VISIONLAB_LOG_FILE_MAX_MB=10
VISIONLAB_LOG_FILE_BACKUP_COUNT=5
VISIONLAB_LOG_REQUEST_ID_ENABLED=true
VISIONLAB_LOG_SLOW_REQUEST_MS=1000
VISIONLAB_LOG_HEALTH_REQUESTS=false
VISIONLAB_LOG_INFERENCE_DETAILS=true
VISIONLAB_LOG_COLORS=auto
VISIONLAB_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
VISIONLAB_DATABASE_URL=sqlite:///./visionlab.db
VISIONLAB_DETECTION_MODEL=yolo26n.pt
VISIONLAB_DETECTION_DEVICE=auto
VISIONLAB_DETECTION_CONFIDENCE=0.25
VISIONLAB_DETECTION_IOU=0.45
VISIONLAB_DETECTION_IMAGE_SIZE=640
VISIONLAB_DETECTION_MAX_DETECTIONS=100
VISIONLAB_DETECTION_CONCURRENCY=1
VISIONLAB_DETECTION_MAX_SOURCE_SIDE=2048
VISIONLAB_FLORENCE_CHECKPOINT=florence-community/Florence-2-base-ft
VISIONLAB_FLORENCE_REVISION=0b03b6f15a4a211370fb204aee4e7dd48887ea37
VISIONLAB_FLORENCE_DEVICE=cpu
VISIONLAB_FLORENCE_MAX_NEW_TOKENS=512
VISIONLAB_FLORENCE_NUM_BEAMS=1
VISIONLAB_FLORENCE_MAX_REGIONS=30
VISIONLAB_FLORENCE_MAX_SOURCE_SIDE=2048
VISIONLAB_MODEL_ROOT=data/models
VISIONLAB_MEDIA_ROOT=data/media
VISIONLAB_THUMBNAIL_ROOT=data/thumbnails
VISIONLAB_MAX_IMAGE_BYTES=20971520
VISIONLAB_MAX_VIDEO_BYTES=262144000
VISIONLAB_MAX_VIDEO_DURATION_MS=600000
VISIONLAB_MAX_IMAGE_PIXELS=40000000
VISIONLAB_FFPROBE_BINARY=ffprobe
VISIONLAB_FFMPEG_BINARY=ffmpeg
VISIONLAB_PROBE_TIMEOUT_SECONDS=15
# Optional cloud vision; keep the key server-side and never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_DETAIL=auto
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_MAX_CONCURRENCY=2
VISIONLAB_OPENAI_MAX_IMAGE_SIDE=1600
VISIONLAB_VIDEO_DETECTION_FPS=2
VISIONLAB_VIDEO_CAPTION_INTERVAL_SECONDS=10
VISIONLAB_VIDEO_MAX_PROCESSED_FRAMES=1800
VISIONLAB_VIDEO_MAX_CAPTION_FRAMES=60
VISIONLAB_VIDEO_ANALYSIS_CONCURRENCY=1
VISIONLAB_VIDEO_MAX_VQA_FRAMES=6
VISIONLAB_VIDEO_MAX_DECODED_FRAMES=100000
VISIONLAB_LIVE_MAX_WIDTH=640
VISIONLAB_LIVE_MAX_HEIGHT=480
VISIONLAB_LIVE_TARGET_FPS=2
